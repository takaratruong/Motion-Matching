{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motion-matching.local/schemas/run_manifest_v1.schema.json",
  "title": "Motion Matching to SONIC run manifest",
  "type": "object",
  "required": [
    "schema",
    "experiment_id",
    "run_id",
    "status",
    "created_utc"
  ],
  "properties": {
    "schema": {"const": "mm-sonic-run-manifest/v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["running", "finalizing", "complete", "failed", "not_run"]},
    "created_utc": {"type": "string", "format": "date-time"},
    "finalization_started_utc": {"type": "string", "format": "date-time"},
    "finalized_utc": {"type": "string", "format": "date-time"},
    "external": {"$ref": "#/$defs/external"},
    "repositories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/repository"}
    },
    "artifact_hashes": {"$ref": "#/$defs/artifactHashes"},
    "command_script": {
      "type": "object",
      "required": ["id", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256OrNull"}
      },
      "additionalProperties": true
    },
    "perturbation": {
      "type": "object",
      "required": ["id", "lateral_offset_m", "yaw_offset_rad"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "lateral_offset_m": {"type": "number"},
        "yaw_offset_rad": {"type": "number"}
      },
      "additionalProperties": false
    },
    "coordinate_transform": {
      "type": "object",
      "required": ["source", "target", "matrix"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "matrix": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "number"}
          }
        }
      },
      "additionalProperties": false
    },
    "scene_registration": {
      "type": "object",
      "required": [
        "scene_id",
        "route_id",
        "source_kind",
        "source_hashes",
        "coordinate_source",
        "coordinate_target",
        "transform_matrix",
        "output_hashes",
        "allowed_foot_geoms",
        "forbidden_geom_groups"
      ],
      "properties": {
        "scene_id": {"type": "string", "minLength": 1},
        "route_id": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "source_kind": {"type": "string", "minLength": 1},
        "source_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "coordinate_source": {"type": "string", "minLength": 1},
        "coordinate_target": {"type": "string", "minLength": 1},
        "transform_matrix": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "number"}
          }
        },
        "output_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "allowed_foot_geoms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "forbidden_geom_groups": {
          "type": "object",
          "required": ["pelvis", "knees", "torso", "hands"],
          "properties": {
            "pelvis": {"$ref": "#/$defs/geomIds"},
            "knees": {"$ref": "#/$defs/geomIds"},
            "torso": {"$ref": "#/$defs/geomIds"},
            "hands": {"$ref": "#/$defs/geomIds"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "processes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "argv"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "argv": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "invocation_cwd": {"type": "string", "pattern": "^/"}
        },
        "additionalProperties": true
      }
    },
    "outcome": {"type": "object"},
    "evidence": {
      "type": "object",
      "required": ["inventory_sha256", "file_count"],
      "properties": {
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "finalizing"}},
        "required": ["status"]
      },
      "then": {"required": ["finalization_started_utc"]}
    },
    {
      "if": {
        "properties": {"status": {"enum": ["complete", "failed", "not_run"]}},
        "required": ["status"]
      },
      "then": {"$ref": "#/$defs/terminalManifest"}
    },
    {
      "if": {
        "properties": {"status": {"const": "complete"}},
        "required": ["status"]
      },
      "then": {
        "required": ["scene_registration"],
        "properties": {
          "artifact_hashes": {"$ref": "#/$defs/completeArtifactHashes"}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"enum": ["complete", "failed"]}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "external": {"$ref": "#/$defs/authenticatedExternal"},
          "repositories": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"$ref": "#/$defs/authenticatedRepository"}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "geomIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "sha256OrNull": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "repository": {
      "type": "object",
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            {"type": "null"}
          ]
        },
        "dirty": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "artifactHashes": {
      "type": "object",
      "required": [
        "policy",
        "encoder",
        "observation_config",
        "model",
        "source_mjcf",
        "motion",
        "terrain",
        "joint_map",
        "scene"
      ],
      "properties": {
        "policy": {"$ref": "#/$defs/sha256OrNull"},
        "encoder": {"$ref": "#/$defs/sha256OrNull"},
        "observation_config": {"$ref": "#/$defs/sha256OrNull"},
        "model": {"$ref": "#/$defs/sha256OrNull"},
        "source_mjcf": {"$ref": "#/$defs/sha256OrNull"},
        "motion": {"$ref": "#/$defs/sha256OrNull"},
        "terrain": {"$ref": "#/$defs/sha256OrNull"},
        "joint_map": {"$ref": "#/$defs/sha256OrNull"},
        "scene": {"$ref": "#/$defs/sha256OrNull"}
      },
      "additionalProperties": false
    },
    "completeArtifactHashes": {
      "type": "object",
      "required": [
        "policy",
        "encoder",
        "observation_config",
        "model",
        "source_mjcf",
        "motion",
        "terrain",
        "joint_map",
        "scene"
      ],
      "properties": {
        "policy": {"$ref": "#/$defs/sha256"},
        "encoder": {"$ref": "#/$defs/sha256OrNull"},
        "observation_config": {"$ref": "#/$defs/sha256"},
        "model": {"$ref": "#/$defs/sha256"},
        "source_mjcf": {"$ref": "#/$defs/sha256"},
        "motion": {"$ref": "#/$defs/sha256"},
        "terrain": {"$ref": "#/$defs/sha256"},
        "joint_map": {"$ref": "#/$defs/sha256"},
        "scene": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "external": {
      "type": "object",
      "required": [
        "gear_checkout",
        "gear_commit",
        "gear_dirty",
        "policy",
        "observation_config",
        "encoder",
        "terrain_dir",
        "source_mjcf",
        "hashes"
      ],
      "properties": {
        "gear_checkout": {"type": "string", "minLength": 1},
        "gear_commit": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            {"type": "null"}
          ]
        },
        "gear_dirty": {"type": ["boolean", "null"]},
        "policy": {"type": "string", "minLength": 1},
        "observation_config": {"type": "string", "minLength": 1},
        "encoder": {"type": ["string", "null"]},
        "terrain_dir": {"type": "string", "minLength": 1},
        "source_mjcf": {"type": "string", "minLength": 1},
        "hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256OrNull"}
        }
      },
      "additionalProperties": false
    },
    "authenticatedRepository": {
      "allOf": [
        {"$ref": "#/$defs/repository"},
        {
          "type": "object",
          "properties": {
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "dirty": {"type": "boolean"}
          }
        }
      ]
    },
    "authenticatedExternal": {
      "allOf": [
        {"$ref": "#/$defs/external"},
        {
          "type": "object",
          "properties": {
            "gear_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "gear_dirty": {"type": "boolean"},
            "hashes": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    },
    "terminalManifest": {
      "type": "object",
      "required": [
        "external",
        "repositories",
        "artifact_hashes",
        "command_script",
        "perturbation",
        "coordinate_transform",
        "processes",
        "outcome",
        "evidence",
        "finalization_started_utc",
        "finalized_utc"
      ]
    }
  },
  "additionalProperties": true
}
