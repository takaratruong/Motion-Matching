{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motion-matching.local/schemas/terrain_oracle_coverage_v1.schema.json",
  "title": "Terrain Oracle Coverage Atlas v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adjacency_rule",
    "bin_definitions",
    "marginal_counts",
    "occupied_cells",
    "connected_components",
    "content_sha256"
  ],
  "properties": {
    "schema": {
      "const": "terrain-oracle-coverage/v1"
    },
    "adjacency_rule": {
      "const": "Two cells are adjacent iff exactly one numeric axis differs by one published ordered category rank; none is nonordered; all categorical axes and other numeric axes are equal."
    },
    "bin_definitions": {
      "$ref": "#/$defs/axes_of_bin_definitions"
    },
    "marginal_counts": {
      "$ref": "#/$defs/axes_of_counts"
    },
    "occupied_cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/occupied_cell"
      }
    },
    "connected_components": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "content_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "axis_names": {
      "enum": [
        "movement_facing_offset",
        "planar_speed",
        "yaw_rate",
        "transition",
        "support_phase",
        "support_leg",
        "step_forward",
        "step_lateral",
        "step_vertical",
        "surface_normal",
        "contact_yaw",
        "swing_clearance",
        "duration",
        "action_class"
      ]
    },
    "bin_definition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "edges",
            "categories",
            "boundary_rule"
          ],
          "properties": {
            "kind": {
              "const": "numeric"
            },
            "edges": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "number",
                "minimum": -1e+308,
                "maximum": 1e+308
              }
            },
            "categories": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "boundary_rule": {
              "const": "half-open; exact edge enters bin beginning at that edge; final category is overflow"
            },
            "direction_speed_threshold_m_s": {
              "const": 0.1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "categories"
          ],
          "properties": {
            "kind": {
              "const": "categorical"
            },
            "categories": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "axes_of_bin_definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "movement_facing_offset",
        "planar_speed",
        "yaw_rate",
        "transition",
        "support_phase",
        "support_leg",
        "step_forward",
        "step_lateral",
        "step_vertical",
        "surface_normal",
        "contact_yaw",
        "swing_clearance",
        "duration",
        "action_class"
      ],
      "properties": {
        "movement_facing_offset": {
          "const": {
            "kind": "numeric",
            "edges": [-3.141592653589793, -2.35619449, -1.57079633, -0.78539816, 0.0, 0.78539816, 1.57079633, 2.35619449, 3.141592653589793],
            "categories": ["[-inf,-3.14159)", "[-3.14159,-2.35619)", "[-2.35619,-1.5708)", "[-1.5708,-0.785398)", "[-0.785398,0)", "[0,0.785398)", "[0.785398,1.5708)", "[1.5708,2.35619)", "[2.35619,3.14159)", "[3.14159,+inf)", "none"],
            "boundary_rule": "half-open; exact edge enters bin beginning at that edge; final category is overflow",
            "direction_speed_threshold_m_s": 0.1
          }
        },
        "planar_speed": {
          "const": {
            "kind": "numeric",
            "edges": [0.0, 0.1, 0.3, 0.6, 1.0, 1.5, 2.5],
            "categories": ["[-inf,0)", "[0,0.1)", "[0.1,0.3)", "[0.3,0.6)", "[0.6,1)", "[1,1.5)", "[1.5,2.5)", "[2.5,+inf)"],
            "boundary_rule": "half-open; exact edge enters bin beginning at that edge; final category is overflow"
          }
        },
        "yaw_rate": {
          "const": {
            "kind": "numeric",
            "edges": [-3.0, -1.5, -0.5, -0.1, 0.1, 0.5, 1.5, 3.0],
            "categories": ["[-inf,-3)", "[-3,-1.5)", "[-1.5,-0.5)", "[-0.5,-0.1)", "[-0.1,0.1)", "[0.1,0.5)", "[0.5,1.5)", "[1.5,3)", "[3,+inf)"],
            "boundary_rule": "half-open; exact edge enters bin beginning at that edge; final category is overflow"
          }
        },
        "transition": {
          "const": {"kind": "categorical", "categories": ["start", "steady", "stop", "reverse"]}
        },
        "support_phase": {
          "const": {"kind": "categorical", "categories": ["flight", "single", "double"]}
        },
        "support_leg": {
          "const": {"kind": "categorical", "categories": ["none", "left", "right"]}
        },
        "step_forward": {
          "const": {
            "kind": "numeric",
            "edges": [-0.6, -0.2, -0.05, 0.05, 0.2, 0.6],
            "categories": ["[-inf,-0.6)", "[-0.6,-0.2)", "[-0.2,-0.05)", "[-0.05,0.05)", "[0.05,0.2)", "[0.2,0.6)", "[0.6,+inf)", "none"],
            "boundary_rule": "half-open; exact edge enters bin beginning at that edge; final category is overflow"
          }
        },
        "step_lateral": {
          "const": {
            "kind": "numeric",
            "edges": [-0.4, -0.15, -0.03, 0.03, 0.15, 0.4],
            "categories": ["[-inf,-0.4)", "[-0.4,-0.15)", "[-0.15,-0.03)", "[-0.03,0.03)", "[0.03,0.15)", "[0.15,0.4)", "[0.4,+inf)", "none"],
            "boundary_rule": "half-open; exact edge enters bin beginning at that edge; final category is overflow"
          }
        },
        "step_vertical": {
          "const": {
            "kind": "numeric",
            "edges": [-0.3, -0.08, -0.015, 0.015, 0.08, 0.3],
            "categories": ["[-inf,-0.3)", "[-0.3,-0.08)", "[-0.08,-0.015)", "[-0.015,0.015)", "[0.015,0.08)", "[0.08,0.3)", "[0.3,+inf)", "none"],
            "boundary_rule": "half-open; exact edge enters bin beginning at that edge; final category is overflow"
          }
        },
        "surface_normal": {
          "const": {
            "kind": "categorical",
            "categories": ["flat:level", "flat:forward", "flat:left", "flat:backward", "flat:right", "moderate:level", "moderate:forward", "moderate:left", "moderate:backward", "moderate:right", "steep:level", "steep:forward", "steep:left", "steep:backward", "steep:right", "overhang:level", "overhang:forward", "overhang:left", "overhang:backward", "overhang:right", "none"]
          }
        },
        "contact_yaw": {
          "const": {
            "kind": "numeric",
            "edges": [-3.141592653589793, -1.57079633, -0.39269908, 0.39269908, 1.57079633, 3.141592653589793],
            "categories": ["[-inf,-3.14159)", "[-3.14159,-1.5708)", "[-1.5708,-0.392699)", "[-0.392699,0.392699)", "[0.392699,1.5708)", "[1.5708,3.14159)", "[3.14159,+inf)", "none"],
            "boundary_rule": "half-open; exact edge enters bin beginning at that edge; final category is overflow"
          }
        },
        "swing_clearance": {
          "const": {
            "kind": "numeric",
            "edges": [0.0, 0.015, 0.04, 0.08, 0.16, 0.32],
            "categories": ["[-inf,0)", "[0,0.015)", "[0.015,0.04)", "[0.04,0.08)", "[0.08,0.16)", "[0.16,0.32)", "[0.32,+inf)", "none"],
            "boundary_rule": "half-open; exact edge enters bin beginning at that edge; final category is overflow"
          }
        },
        "duration": {
          "const": {
            "kind": "numeric",
            "edges": [0.0, 0.2, 0.5, 1.0, 2.0, 5.0, 10.0],
            "categories": ["[-inf,0)", "[0,0.2)", "[0.2,0.5)", "[0.5,1)", "[1,2)", "[2,5)", "[5,10)", "[10,+inf)"],
            "boundary_rule": "half-open; exact edge enters bin beginning at that edge; final category is overflow"
          }
        },
        "action_class": {
          "const": {"kind": "categorical", "categories": ["walk", "run", "start", "stop", "reverse", "ascent", "descent", "turn", "sidestep", "other"]}
        }
      }
    },
    "counts": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "axes_of_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "movement_facing_offset",
        "planar_speed",
        "yaw_rate",
        "transition",
        "support_phase",
        "support_leg",
        "step_forward",
        "step_lateral",
        "step_vertical",
        "surface_normal",
        "contact_yaw",
        "swing_clearance",
        "duration",
        "action_class"
      ],
      "properties": {
        "movement_facing_offset": {"$ref": "#/$defs/counts"},
        "planar_speed": {"$ref": "#/$defs/counts"},
        "yaw_rate": {"$ref": "#/$defs/counts"},
        "transition": {"$ref": "#/$defs/counts"},
        "support_phase": {"$ref": "#/$defs/counts"},
        "support_leg": {"$ref": "#/$defs/counts"},
        "step_forward": {"$ref": "#/$defs/counts"},
        "step_lateral": {"$ref": "#/$defs/counts"},
        "step_vertical": {"$ref": "#/$defs/counts"},
        "surface_normal": {"$ref": "#/$defs/counts"},
        "contact_yaw": {"$ref": "#/$defs/counts"},
        "swing_clearance": {"$ref": "#/$defs/counts"},
        "duration": {"$ref": "#/$defs/counts"},
        "action_class": {"$ref": "#/$defs/counts"}
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "movement_facing_offset",
        "planar_speed",
        "yaw_rate",
        "transition",
        "support_phase",
        "support_leg",
        "step_forward",
        "step_lateral",
        "step_vertical",
        "surface_normal",
        "contact_yaw",
        "swing_clearance",
        "duration",
        "action_class"
      ],
      "properties": {
        "movement_facing_offset": {"enum": ["[-inf,-3.14159)", "[-3.14159,-2.35619)", "[-2.35619,-1.5708)", "[-1.5708,-0.785398)", "[-0.785398,0)", "[0,0.785398)", "[0.785398,1.5708)", "[1.5708,2.35619)", "[2.35619,3.14159)", "[3.14159,+inf)", "none"]},
        "planar_speed": {"enum": ["[-inf,0)", "[0,0.1)", "[0.1,0.3)", "[0.3,0.6)", "[0.6,1)", "[1,1.5)", "[1.5,2.5)", "[2.5,+inf)"]},
        "yaw_rate": {"enum": ["[-inf,-3)", "[-3,-1.5)", "[-1.5,-0.5)", "[-0.5,-0.1)", "[-0.1,0.1)", "[0.1,0.5)", "[0.5,1.5)", "[1.5,3)", "[3,+inf)"]},
        "transition": {"enum": ["start", "steady", "stop", "reverse"]},
        "support_phase": {"enum": ["flight", "single", "double"]},
        "support_leg": {"enum": ["none", "left", "right"]},
        "step_forward": {"enum": ["[-inf,-0.6)", "[-0.6,-0.2)", "[-0.2,-0.05)", "[-0.05,0.05)", "[0.05,0.2)", "[0.2,0.6)", "[0.6,+inf)", "none"]},
        "step_lateral": {"enum": ["[-inf,-0.4)", "[-0.4,-0.15)", "[-0.15,-0.03)", "[-0.03,0.03)", "[0.03,0.15)", "[0.15,0.4)", "[0.4,+inf)", "none"]},
        "step_vertical": {"enum": ["[-inf,-0.3)", "[-0.3,-0.08)", "[-0.08,-0.015)", "[-0.015,0.015)", "[0.015,0.08)", "[0.08,0.3)", "[0.3,+inf)", "none"]},
        "surface_normal": {"enum": ["flat:level", "flat:forward", "flat:left", "flat:backward", "flat:right", "moderate:level", "moderate:forward", "moderate:left", "moderate:backward", "moderate:right", "steep:level", "steep:forward", "steep:left", "steep:backward", "steep:right", "overhang:level", "overhang:forward", "overhang:left", "overhang:backward", "overhang:right", "none"]},
        "contact_yaw": {"enum": ["[-inf,-3.14159)", "[-3.14159,-1.5708)", "[-1.5708,-0.392699)", "[-0.392699,0.392699)", "[0.392699,1.5708)", "[1.5708,3.14159)", "[3.14159,+inf)", "none"]},
        "swing_clearance": {"enum": ["[-inf,0)", "[0,0.015)", "[0.015,0.04)", "[0.04,0.08)", "[0.08,0.16)", "[0.16,0.32)", "[0.32,+inf)", "none"]},
        "duration": {"enum": ["[-inf,0)", "[0,0.2)", "[0.2,0.5)", "[0.5,1)", "[1,2)", "[2,5)", "[5,10)", "[10,+inf)"]},
        "action_class": {"enum": ["walk", "run", "start", "stop", "reverse", "ascent", "descent", "turn", "sidestep", "other"]}
      }
    },
    "frame_interval": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "occupied_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "coordinates",
        "source_ids",
        "dedup_group_ids",
        "contribution_count",
        "intervals",
        "contributions"
      ],
      "properties": {
        "cell_id": {"$ref": "#/$defs/sha256"},
        "coordinates": {"$ref": "#/$defs/coordinates"},
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "dedup_group_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "contribution_count": {
          "type": "integer",
          "minimum": 1
        },
        "intervals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/frame_interval"}
        },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/contribution"}
        }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contribution_id",
        "semantic_digest",
        "source_sha256",
        "dedup_group_id",
        "clip_sha256",
        "accepted_interval"
      ],
      "properties": {
        "contribution_id": {"$ref": "#/$defs/sha256"},
        "semantic_digest": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "dedup_group_id": {"$ref": "#/$defs/sha256"},
        "clip_sha256": {"$ref": "#/$defs/sha256"},
        "accepted_interval": {"$ref": "#/$defs/frame_interval"}
      }
    }
  }
}
